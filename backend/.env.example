# Server
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL no Docker mapeado na porta 5433 para não conflitar com PostgreSQL local do Windows na 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/daily_reminder

# JWT Auth
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Observability (Sentry)
SENTRY_DSN=
